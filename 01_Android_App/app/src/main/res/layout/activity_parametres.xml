<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050508"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <!-- EN-TÊTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/boutonRetourParametres"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FF4FA3"
                android:textSize="40sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙ PARAMÈTRES"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RoseLed Controller Pro"
                    android:textColor="#FF4FA3"
                    android:textSize="13sp" />

            </LinearLayout>

            <Space
                android:layout_width="52dp"
                android:layout_height="52dp" />

        </LinearLayout>

        <View
            android:layout_width="110dp"
            android:layout_height="2dp"
            android:layout_gravity="center_horizontal"
            android:background="#FF2E8B" />

        <!-- CONTRÔLEUR -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="●  CONTRÔLEUR"
            android:textColor="#FF5AA7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#171018"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nom Bluetooth"
                android:textColor="#9D9DA5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/texteNomBluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="RoseLed Controller Pro"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#35202E" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Version du firmware"
                android:textColor="#9D9DA5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/texteVersionFirmware"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Non disponible"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CONNEXION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="⚡  CONNEXION"
            android:textColor="#FF5AA7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#171018"
            android:orientation="vertical"
            android:padding="18dp">

            <Switch
                android:id="@+id/interrupteurConnexionAuto"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:checked="false"
                android:text="Connexion automatique"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:thumbTint="#FF4FA3"
                android:trackTint="#633047" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Se connecter automatiquement au contrôleur RoseLed."
                android:textColor="#909096"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:background="#35202E" />

            <Switch
                android:id="@+id/interrupteurReconnexionAuto"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:checked="true"
                android:text="Reconnexion automatique"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:thumbTint="#FF4FA3"
                android:trackTint="#633047" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prépare la reconnexion après une perte de liaison."
                android:textColor="#909096"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- LUMINOSITÉ AU DÉMARRAGE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="☀  LUMINOSITÉ AU DÉMARRAGE"
                android:textColor="#FF5AA7"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/texteLuminositeDemarrage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50 %"
                android:textColor="#FF70B4"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <SeekBar
            android:id="@+id/curseurLuminositeDemarrage"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:max="100"
            android:progress="50"
            android:progressTint="#FF2E8B"
            android:thumbTint="#FF79B9" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cette valeur sera utilisée comme réglage par défaut de l'application."
            android:textColor="#909096"
            android:textSize="12sp" />

        <!-- APPLICATION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="ⓘ  APPLICATION"
            android:textColor="#FF5AA7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#171018"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Version de l'application"
                android:textColor="#9D9DA5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/texteVersionApplication"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1.0"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#35202E" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Communication"
                android:textColor="#9D9DA5"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bluetooth Classic"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- AVERTISSEMENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="#21121D"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌹 ROSELED CONTROLLER PRO"
                android:textColor="#FF70B4"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Les paramètres liés au contrôleur seront activés progressivement après validation de la communication avec le matériel."
                android:textColor="#B8B8BE"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="RoseLed Controller Pro"
            android:textColor="#76566A"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>