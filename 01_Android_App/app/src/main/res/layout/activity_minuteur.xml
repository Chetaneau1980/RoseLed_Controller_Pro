<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050508"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <!-- EN-TÊTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/boutonRetourMinuteur"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FF4FA3"
                android:textSize="40sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱ MINUTEUR"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RoseLed Controller Pro"
                    android:textColor="#FF4FA3"
                    android:textSize="13sp" />

            </LinearLayout>

            <Space
                android:layout_width="52dp"
                android:layout_height="52dp" />

        </LinearLayout>

        <View
            android:layout_width="110dp"
            android:layout_height="2dp"
            android:layout_gravity="center_horizontal"
            android:background="#FF2E8B" />

        <!-- COMPTEUR -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="TEMPS RESTANT"
            android:textColor="#A8A8AE"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/texteTempsRestant"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp"
            android:background="#171018"
            android:gravity="center"
            android:text="00:30:00"
            android:textColor="#FF4FA3"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/texteDureeSelectionnee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Durée sélectionnée : 30 minutes"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- CHOIX DURÉE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="CHOISIR LA DURÉE"
            android:textColor="#FF5AA7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sélectionnez la durée avant l'extinction."
            android:textColor="#9D9DA5"
            android:textSize="13sp" />

        <!-- 15 / 30 MIN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/duree15Minutes"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#21121D"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="15 MIN"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/duree30Minutes"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="#351020"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="30 MIN"
                android:textColor="#FF70B4"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 1H / 2H -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/duree1Heure"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#21121D"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="1 HEURE"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/duree2Heures"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="#21121D"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="2 HEURES"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- DÉMARRER -->
        <Button
            android:id="@+id/boutonDemarrerMinuteur"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#C2185B"
            android:text="▶  DÉMARRER LE MINUTEUR"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- ANNULER -->
        <Button
            android:id="@+id/boutonAnnulerMinuteur"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#351820"
            android:enabled="false"
            android:text="✕  ANNULER"
            android:textColor="#FF789D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- INFORMATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#171018"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 EXTINCTION AUTOMATIQUE"
                android:textColor="#FF5AA7"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="À la fin du minuteur, RoseLed pourra éteindre automatiquement l'éclairage."
                android:textColor="#B8B8BE"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="RoseLed Controller Pro"
            android:textColor="#76566A"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>