<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050508">

    <!-- ====================================================== -->
    <!-- ÉCRAN PRINCIPAL -->
    <!-- ====================================================== -->

    <ScrollView
        android:id="@+id/contenuPrincipal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#050508"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <!-- EN-TÊTE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/boutonMenu"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="☰"
                    android:textColor="#FF4FA3"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RoseLed 🌹"
                        android:textColor="#FF4FA3"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Controller Pro"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- équilibre visuel -->
                <Space
                    android:layout_width="52dp"
                    android:layout_height="52dp" />

            </LinearLayout>

            <View
                android:layout_width="100dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="#FF2E8B" />

            <!-- CONNEXION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="●  CONNEXION"
                android:textColor="#FF5AA7"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/texteEtatBluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#171018"
                android:gravity="center"
                android:padding="18dp"
                android:text="@string/bluetooth_status_disconnected"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/boutonConnecter"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#C2185B"
                android:text="⚡  CONNECTER EN BLUETOOTH"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/boutonDeconnecter"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#8E1648"
                android:text="DÉCONNECTER"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- COULEUR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="◉  COULEUR"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#171018"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <View
                    android:id="@+id/apercuCouleur"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/color_preview_background"
                    android:contentDescription="@string/color_preview_description" />

                <Button
                    android:id="@+id/boutonChoisirCouleur"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:backgroundTint="#C2185B"
                    android:enabled="false"
                    android:text="CHOISIR LA COULEUR"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- LUMINOSITÉ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="☀  LUMINOSITÉ"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/texteLuminosite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50 %"
                    android:textColor="#FF4FA3"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <SeekBar
                android:id="@+id/curseurLuminosite"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:enabled="false"
                android:max="100"
                android:progress="50"
                android:progressTint="#FF2E8B"
                android:thumbTint="#FF79B9" />

            <!-- ANIMATIONS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="☆  ANIMATIONS"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Choisissez votre ambiance lumineuse"
                android:textColor="#9D9DA5"
                android:textSize="13sp" />

            <!-- Arc-en-ciel / Respiration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/carteArcEnCiel"
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="#21121D"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🌈&#10;Arc-en-ciel"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/carteRespiration"
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#21121D"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="💗&#10;Respiration"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Feu / Océan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/carteFeu"
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="#21121D"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🔥&#10;Feu"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/carteOcean"
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#21121D"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🌊&#10;Océan"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Flash / Fixe -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/carteFlash"
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="#21121D"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⚡&#10;Flash"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/carteFixe"
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#21121D"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🎨&#10;Fixe"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- OCTOBRE ROSE -->
            <Button
                android:id="@+id/boutonOctobreRose"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#351020"
                android:enabled="false"
                android:text="🎀  MODE OCTOBRE ROSE"
                android:textColor="#FF70B4"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- OFF -->
            <Button
                android:id="@+id/boutonEteindre"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/off_button_background"
                android:enabled="false"
                android:text="⏻  ÉTEINDRE TOUT"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- NAVIGATION -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="26dp"
                android:background="#3A2030" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="⌂&#10;Accueil"
                    android:textColor="#FF4FA3"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="☆&#10;Favoris"
                    android:textColor="#BDBDBD"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="♫&#10;Musique"
                    android:textColor="#BDBDBD"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="ⓘ&#10;À propos"
                    android:textColor="#BDBDBD"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- ====================================================== -->
    <!-- VOILE SOMBRE DERRIÈRE LE MENU -->
    <!-- ====================================================== -->

    <View
        android:id="@+id/voileMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:visibility="gone" />

    <!-- ====================================================== -->
    <!-- MENU LATÉRAL ROSELED -->
    <!-- ====================================================== -->

    <LinearLayout
        android:id="@+id/menuLateral"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:background="#110B11"
        android:elevation="18dp"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="36dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp"
        android:translationX="-320dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RoseLed 🌹"
            android:textColor="#FF4FA3"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Controller Pro"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="14dp"
            android:background="#472035" />

        <TextView
            android:id="@+id/menuAccueil"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:text="⌂     Accueil"
            android:textColor="#FF5AA7"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuFavoris"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:text="☆     Favoris"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/menuAnimations"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:text="✦     Animations"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/menuMinuteur"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:text="◷     Minuteur"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/menuParametres"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:text="⚙     Paramètres"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/menuAPropos"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:text="ⓘ     À propos"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/menuDeconnecter"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:text="⏻     Déconnecter"
            android:textColor="#FF557F"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="RoseLed Controller Pro"
            android:textColor="#76566A"
            android:textSize="11sp" />

    </LinearLayout>

</FrameLayout>