<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030306">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="28dp">

        <!-- Logo RoseLed -->
        <ImageView
            android:id="@+id/logoRoseLed"
            android:layout_width="270dp"
            android:layout_height="270dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/splash_logo_description"
            android:scaleType="fitCenter"
            android:src="@drawable/roseled_logo" />

        <!-- Titre -->
        <TextView
            android:id="@+id/titleRoseLed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/splash_title"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <!-- Sous-titre -->
        <TextView
            android:id="@+id/subtitleRoseLed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/splash_subtitle"
            android:textColor="#FF5AA5"
            android:textSize="16sp" />

        <!-- Espace -->
        <Space
            android:layout_width="1dp"
            android:layout_height="26dp" />

        <!-- Initialisation -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INITIALISATION"
            android:textColor="#FF4F9F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Bluetooth -->
        <TextView
            android:id="@+id/statusBluetooth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="✓  Bluetooth"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Firmware -->
        <TextView
            android:id="@+id/statusFirmware"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="✓  Firmware"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Interface -->
        <TextView
            android:id="@+id/statusInterface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="✓  Interface"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Contrôleur prêt -->
        <TextView
            android:id="@+id/statusReady"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="✓  Contrôleur prêt"
            android:textColor="#FF4F9F"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Barre de chargement -->
        <ProgressBar
            android:id="@+id/progressSplash"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="22dp"
            android:max="100"
            android:progress="100"
            android:progressTint="#FF2F92"
            android:progressBackgroundTint="#321426" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Chargement... 100%"
            android:textColor="#FF69B4"
            android:textSize="14sp" />

        <!-- Version -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Version 1.0"
            android:textColor="#D94B91"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>